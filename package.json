{
  "name": "ai-proxy",
  "version": "0.3.0",
  "description": "Unified local proxy: OpenAI (codexer) + Anthropic (native pool) on one port.",
  "type": "module",
  "bin": {
    "ai-proxy": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js start --foreground",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "install-binaries": "bash scripts/install-binaries.sh",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
