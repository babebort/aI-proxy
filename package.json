{
  "name": "ai-proxy",
  "version": "0.3.0",
  "description": "Unified local proxy: OpenAI (codexer) + Anthropic (native pool) on one port.",
  "type": "module",
  "bin": {
    "ai-proxy": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "build:codexer": "go build -C codexer -o resources/bin/codexer .",
    "start": "node dist/cli.js start --foreground",
    "dev": "node --experimental-transform-types src/cli.ts",
    "test": "npm run build && node --test dist/**/*.test.js",
    "install-binaries": "bash scripts/install-binaries.sh",
    "setup": "npm install && npm run build && npm run install-binaries",
    "openai:login": "node dist/cli.js openai login",
    "anthropic:login": "node dist/cli.js anthropic login",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
