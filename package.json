{
  "name": "ai-proxy",
  "version": "0.4.0",
  "description": "Unified local proxy with browser control panel (OpenAI codexer + Anthropic pool).",
  "type": "module",
  "bin": {
    "ai-proxy": "./dist/bootstrap.js"
  },
  "scripts": {
    "compile": "tsc && chmod +x dist/main.js dist/bootstrap.js dist/stop.js",
    "build": "npm run compile",
    "start": "node dist/bootstrap.js",
    "start:fg": "node dist/main.js --foreground",
    "stop": "node dist/stop.js",
    "open": "node dist/main.js --open-only",
    "dev": "node --experimental-transform-types src/main.ts",
    "test": "npm run compile && node --test dist/**/*.test.js",
    "install-binaries": "bash scripts/install-binaries.sh",
    "link-bin": "bash scripts/link-local-bin.sh",
    "install-app": "bash scripts/install-macos-app.sh",
    "setup": "npm install && npm run compile && npm run install-binaries && npm run link-bin",
    "prepack": "npm run compile"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
