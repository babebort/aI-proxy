{
  "name": "ai-proxy",
  "version": "0.2.0",
  "description": "Unified local proxy: OpenAI (codexer) + Anthropic (native pool) on one port.",
  "type": "module",
  "bin": {
    "ai-proxy": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js start --foreground",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "install-binaries": "bash scripts/install-binaries.sh",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
